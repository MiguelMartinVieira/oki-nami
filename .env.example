# Copia este archivo a .env y rellena lo que uses. Todo es opcional:
# sin nada configurado la app arranca con el CSV local, y con DEMO_MODE=true
# arranca con datos sintéticos sin tocar ninguna API.

# ── Modos ───────────────────────────────────────────────
DEMO_MODE=false        # datos sintéticos, escrituras bloqueadas
CIPHER_MODE=false      # datos reales, cifras ocultas en la UI

# ── Google Sheets (Libro Diario) ───────────────────────
# GSHEETS_URL="https://docs.google.com/spreadsheets/d/<SHEET_ID>"
# GSHEETS_CREDENTIALS_FILE="/ruta/a/credentials.json"   # service account
# URL_CENTRO_CONTROL="https://docs.google.com/spreadsheets/d/<SHEET_ID>"
# CSV_URL_DIARIO_CRUDO=""   # CSV publicado en la web, fallback HTTP

# ── Google Drive (tickets) ─────────────────────────────
# PADRES_DRIVE_FOLDER_ID=""
# PADRES_DOC_ID=""          # vacío = autodescubre el Doc de la carpeta
# BOKATAS_DRIVE_FOLDER_ID=""
# BOKATAS_VERSION_SHEET_URL=""
# QUOTES_DOC_ID=""          # Google Doc con citas para la cabecera

# ── Gemini (OCR de tickets) ────────────────────────────
# GEMINI_API_KEY=""

# ── Posiciones de inversión ────────────────────────────
# PARTICIPACIONES_VANGUARD=6.5
# BASE_ACCIONES_BRK=0.0
# BRK_CHECKPOINT_DATE=2026-03-23
# VANGUARD_HISTORICAL_GAIN=0.0
